{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cmn:s2-attestation-statement:v1-draft",
  "title": "S2-B2 batch 3 attestation statement (DRAFT, not implemented)",
  "description": "Draft only (S2B2-B3-PLAN.md section 7). No code produces or verifies this yet. A statement is never trusted on its own: the Verifier recomputes every digest and the canonical from artifacts using the trusted toolchain, and compares every target field with trusted external inputs (plan section 7.2). 'verdict' is written only by the Verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "testId", "backend", "toolchain", "targets", "run", "environment", "isolation", "artifacts", "reconciliation", "observed", "adapterClaimedCanonical", "verdict"],
  "$defs": {
    "sha1Commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "Validated with the strict whole-string + real-date rules of S2-B1 AUTHORIZATION 7.6, not only this pattern." },
    "fileDigest": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": { "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,200}$" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 0 } }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["name", "ok", "observed"],
      "properties": { "name": { "type": "string" }, "ok": { "type": "boolean" }, "observed": { "type": "string", "maxLength": 200 } }
    }
  },
  "properties": {
    "schemaVersion": { "const": "s2-attestation-v1" },
    "testId": { "type": "string", "pattern": "^POC-[0-9]{3}$" },
    "backend": { "const": "firebase" },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["trustedToolchainCommit", "adapterCommit", "verifierCommit", "observerCommit", "sandboxLauncherSha256"],
      "properties": {
        "trustedToolchainCommit": { "$ref": "#/$defs/sha1Commit", "description": "Must equal the repository variable CMN_S2_TRUSTED_TOOLCHAIN_SHA and be an ancestor of main." },
        "adapterCommit": { "$ref": "#/$defs/sha1Commit", "description": "Code under test; bound separately; never changes the trusted components." },
        "verifierCommit": { "$ref": "#/$defs/sha1Commit", "description": "Must equal trustedToolchainCommit." },
        "observerCommit": { "$ref": "#/$defs/sha1Commit", "description": "Must equal trustedToolchainCommit." },
        "sandboxLauncherSha256": { "$ref": "#/$defs/sha256", "description": "Recomputed by the Verifier from trustedToolchainCommit." }
      }
    },
    "targets": {
      "type": "object", "additionalProperties": false,
      "required": ["caseSpecDigest", "oracleFileSha256", "fixtureFileSha256", "fixtureHash", "anchorDigest"],
      "properties": {
        "caseSpecDigest": { "$ref": "#/$defs/sha256" },
        "oracleFileSha256": { "$ref": "#/$defs/sha256" },
        "fixtureFileSha256": { "$ref": "#/$defs/sha256" },
        "fixtureHash": { "$ref": "#/$defs/sha256" },
        "anchorDigest": { "$ref": "#/$defs/sha256", "description": "Must equal the repository variable CMN_STAGE1_ANCHOR_SHA256." }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "runAttempt", "attestationNonce", "ownershipNonceSha256", "nonceWrittenAt", "startedAt", "finishedAt"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[0-9]{1,20}$", "description": "Compared with the execution run the Verifier was triggered for, not read from the artifact alone." },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "attestationNonce": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Generated at T0, written at T3 (plan section 5); passed to the Verifier as a job output and compared with the marker in state-post." },
        "ownershipNonceSha256": { "$ref": "#/$defs/sha256", "description": "Batch 1/2 ownership marker; a different value from attestationNonce." },
        "nonceWrittenAt": { "$ref": "#/$defs/utc" },
        "startedAt": { "$ref": "#/$defs/utc" },
        "finishedAt": { "$ref": "#/$defs/utc" }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["osImage", "node", "java", "firebaseTools", "firestoreJarMd5", "stage2LockfileSha256", "runnerKind"],
      "properties": {
        "osImage": { "type": "string" }, "node": { "type": "string" }, "java": { "type": "string" },
        "firebaseTools": { "const": "15.35.0" },
        "firestoreJarMd5": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "stage2LockfileSha256": { "$ref": "#/$defs/sha256" },
        "runnerKind": { "enum": ["github-hosted", "local-untrusted"], "description": "local-untrusted can never yield PASS." }
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["selfCheck", "termination"],
      "properties": {
        "selfCheck": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" }, "description": "Plan section 3.3; every item must be ok, else BLOCKED; missing → UNATTESTED." },
        "termination": {
          "type": "object", "additionalProperties": false, "required": ["namespaceTerminated", "remainingAdapterProcesses", "exportAfterTermination"],
          "properties": { "namespaceTerminated": { "type": "boolean" }, "remainingAdapterProcesses": { "type": "integer", "minimum": 0 }, "exportAfterTermination": { "type": "boolean" } }
        }
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["traceFront", "traceBack", "statePre", "statePost", "evidenceFiles"],
      "properties": {
        "traceFront": { "$ref": "#/$defs/fileDigest" }, "traceBack": { "$ref": "#/$defs/fileDigest" },
        "statePre": { "$ref": "#/$defs/fileDigest" }, "statePost": { "$ref": "#/$defs/fileDigest" },
        "evidenceFiles": { "type": "array", "items": { "$ref": "#/$defs/fileDigest" } }
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["frontRequests", "auditAdded", "auditMatched", "auditModifiedOrDeleted", "nonceMarkerUnchanged", "unexplainedChanges", "unattributedBackendRequests", "nonAuditBackendWrites"],
      "properties": {
        "frontRequests": { "type": "integer", "minimum": 0 }, "auditAdded": { "type": "integer", "minimum": 0 }, "auditMatched": { "type": "integer", "minimum": 0 },
        "auditModifiedOrDeleted": { "type": "integer", "minimum": 0 }, "nonceMarkerUnchanged": { "type": "boolean" },
        "unexplainedChanges": { "type": "integer", "minimum": 0 }, "unattributedBackendRequests": { "type": "integer", "minimum": 0 }, "nonAuditBackendWrites": { "type": "integer", "minimum": 0 }
      }
    },
    "observed": {
      "type": "object", "additionalProperties": false, "required": ["canonical", "canonicalDigest", "blockedFields"],
      "properties": {
        "canonical": { "type": ["object", "null"] },
        "canonicalDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "blockedFields": { "type": "array", "items": { "type": "string" }, "description": "e.g. POC-009 applicability / pendingPeriods (G-1, G-4)." }
      }
    },
    "adapterClaimedCanonical": { "type": ["object", "null"], "description": "Recorded for comparison only." },
    "verdict": {
      "type": "object", "additionalProperties": false, "required": ["result", "reasons", "verifiedAt"],
      "properties": {
        "result": { "enum": ["PASS", "FAIL", "BLOCKED", "UNATTESTED"] },
        "reasons": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } },
        "verifiedAt": { "$ref": "#/$defs/utc" }
      }
    }
  }
}
